// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"nodeGypDependencies": true,
			"installYarnUsingApt": true,
			"version": "lts",
			"pnpmVersion": "latest",
			"nvmVersion": "latest"
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
		}
	},
	
	"postCreateCommand": "sh .devcontainer/installation.sh",
//  the userns stuff below is to fix the permission issues with filesystem mappingon podman
//	"runArgs": ["--name", "robref.ddd.claude",  "--userns=keep-id:uid=1000,gid=1000"],
	"runArgs": ["--name", "robref.ddd.claude"],
 	"containerUser": "vscode",
 	"remoteUser": "vscode",
	"updateRemoteUserUID": true,
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"ms-vscode-remote.remote-containers",
				"ms-azuretools.vscode-containers",
				"ms-mssql.mssql",
				"Anthropic.claude-code",
				"openai.chatgpt"
			]
		}
	},
	"containerEnv": {
		"TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
		"TESTCONTAINERS_RYUK_DISABLED": "true"
	}
}